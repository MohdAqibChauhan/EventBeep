{
  "name": "eventbeep-fresher-jobs",
  "version": "1.0.0",
  "private": true,
  "description": "Beep Career Platform - Live AI-Tagged India Fresher & Internship Job Aggregator",
  "scripts": {
    "dev": "tsx watch server/index.ts",
    "start": "tsx server/index.ts",
    "collect": "tsx server/cli-collect.ts",
    "tag": "python tagger/tag_jobs.py",
    "evaluate": "python tagger/evaluate.py",
    "test": "tsx server/test-suite.ts",
    "pipeline": "tsx server/cli-collect.ts && python tagger/tag_jobs.py"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
